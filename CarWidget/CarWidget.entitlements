<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  小组件扩展权限：只声明 App Group（读取主 App 写入的车况快照）。

  为什么不放 keychain-access-groups：小组件进程本身不访问钥匙串——
  时间线只读 App Group 快照；桌面/锁屏上的交互按钮（开锁、闪灯等）
  其 App Intent 由系统拉到「主 App 进程」里执行，凭据访问发生在 App 侧。
  少声明一项 entitlement，小组件描述文件就少一个必须勾选的能力，
  降低后台配置漏勾导致签名失败的概率。
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.6cd6b6c14418f98a.1</string>
	</array>
</dict>
</plist>
