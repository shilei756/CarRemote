<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  小组件扩展权限：App Group + 钥匙串共享组。

  为什么加 keychain-access-groups：全能签/重签环境下 App Group 容器
  可能失效，小组件进程需要直接从共享钥匙串读凭据与车况快照兜底。
  组名必须与主 App 的 CarRemote.entitlements 完全一致。
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.6cd6b6c14418f98a.1</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>7NSH43RT4Z.carremote</string>
	</array>
</dict>
</plist>
