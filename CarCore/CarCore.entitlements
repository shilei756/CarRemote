<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  共享框架权限：CarCore 会读写 App Group 与共享 Keychain，
  嵌入式框架同样需要这两项 entitlement 才能随宿主进程访问。
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.6cd6b6c14418f98a.1</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>7NSH43RT4Z.carremote</string>
	</array>
</dict>
</plist>
